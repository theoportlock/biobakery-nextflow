/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    NeSI-specific database configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Database paths for HUMAnN, MetaPhlAn, and KneadData
    These parameters override base config settings
----------------------------------------------------------------------------------------
*/

params {
    // Input data
    input = '/nesi/nobackup/uoa03624/kneaddata/*_kneaddata_paired_{1,2}.fastq.gz'

    // NeSI project account
    project = 'uoa03941'

    // Pipeline flags
    k = false  // KneadData
    m = false  // MetaPhlAn (use modified precomputed profiles)
    h = true   // HUMAnN (enable)
    s = false  // StrainPhlAn

    // KneadData database
    kneaddata_db_dir = '/nesi/nobackup/uoa03941/databases/kneaddata_db'

    // MetaPhlAn databases and profiles
    metaphlan_db_dir = '/nesi/nobackup/uoa03941/databases/metaphlan_db'
    metaphlan_bowtie2_db_dir = '/nesi/nobackup/uoa03941/databases/metaphlan_db/mpa_latest'
    metaphlan_db = 'mpa_vJun23_CHOCOPhlAnSGB_202307'  // Compatible with HUMAnN 3.9
    metaphlan_profile_dir = '/nesi/nobackup/uoa03624/metaphlan_vJun23_compat'

    // HUMAnN database
    humann_db_dir = '/nesi/nobackup/uoa03941/databases/humann_db'
}
